# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# @currentEnv=$APP_ENV
# @defaultRequired=false
# ---

# Runtime environment used by Varlock for environment-specific validation.
# @type=enum(development, preview, production, test)
APP_ENV=development

# Bitwarden Secrets Manager machine account token.
# Store this in your shell or deployment platform, not in committed files.
# Required only when a value uses bitwarden("<secret-uuid>").
# @type=bitwardenAccessToken
BITWARDEN_ACCESS_TOKEN=

# Public URL of the SvelteKit app, also used by Better Auth in Convex.
# @type=url @required=forEnv(preview, production)
SITE_URL=

# Better Auth signing/encryption secret.
# May be set directly in an uncommitted .env.local, or via Bitwarden:
# BETTER_AUTH_SECRET=bitwarden("00000000-0000-0000-0000-000000000000")
# @sensitive @required=forEnv(preview, production)
BETTER_AUTH_SECRET=

# Convex deployment name written by the Convex CLI.
CONVEX_DEPLOYMENT=

# Convex deployment URL used by the browser client; must end in .convex.cloud.
# @type=url(matches=/^https:\/\/[^/]+\.convex\.cloud\/?$/) @required=forEnv(preview, production)
PUBLIC_CONVEX_URL=

# Convex site URL used by SvelteKit auth proxying; must end in .convex.site.
# @type=url(matches=/^https:\/\/[^/]+\.convex\.site\/?$/) @required=forEnv(preview, production)
PUBLIC_CONVEX_SITE_URL=

# Private UploadThing token used to sign upload requests.
# @sensitive @required=forEnv(preview, production)
UPLOADTHING_TOKEN=

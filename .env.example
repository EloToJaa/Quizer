# Copy to .env.local for local development. Keep .env.local uncommitted.
APP_ENV=development
SITE_URL=http://localhost:5173
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_SITE_URL=

# For direct local development only. Prefer Bitwarden for shared/preview/production secrets.
BETTER_AUTH_SECRET=

# Set in your shell or deployment platform when using bitwarden("<secret-uuid>").
BITWARDEN_ACCESS_TOKEN=

# Example Bitwarden-backed secret override:
# BETTER_AUTH_SECRET=bitwarden("00000000-0000-0000-0000-000000000000")

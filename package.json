{
	"name": "quizer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "varlock run --inject vars -- vite dev",
		"convex": "varlock run --inject vars -- convex dev",
		"build": "varlock run --inject vars -- vite build",
		"preview": "varlock run --inject vars -- vite preview",
		"env:check": "varlock load --agent",
		"env:check:all": "varlock load --show-all",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "varlock run --inject vars -- vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "varlock run --inject vars -- playwright install && varlock run --inject vars -- playwright test"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260606.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@varlock/bitwarden-plugin": "^1.0.0",
		"@vitest/browser-playwright": "^4.1.3",
		"better-auth": "~1.4.21",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-neverthrow": "^1.1.4",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"varlock": "^1.5.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"void": "^0.9.2"
	},
	"dependencies": {
		"@convex-dev/better-auth": "^0.12.2",
		"@logtail/edge": "^0.5.8",
		"convex": "^1.40.0",
		"convex-svelte": "^0.0.12",
		"neverthrow": "^8.2.0",
		"runed": "^0.37.1"
	}
}
